apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{ frontend_ingress_name }}
  namespace: {{ app_ingress_namespace }}
spec:
  ingressClassName: {{ app_ingress_class_name }}
  rules:
    - http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: {{ frontend_service_name }}
                port:
                  number: {{ frontend_service_port }}
