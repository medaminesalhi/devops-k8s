apiVersion: v1
kind: Secret
metadata:
  name: {{ mysql_secret_name }}
  namespace: {{ app_namespace }}
  labels:
    app: mysql
    component: database
    managed-by: ansible
type: Opaque
stringData:
  MYSQL_ROOT_PASSWORD: "{{ vault_mysql_root_password }}"
  MYSQL_DATABASE: "{{ mysql_database }}"
  MYSQL_USER: "{{ mysql_app_user }}"
  MYSQL_PASSWORD: "{{ vault_mysql_app_password }}"
