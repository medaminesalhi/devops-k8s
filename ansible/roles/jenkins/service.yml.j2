apiVersion: v1
kind: Service
metadata:
  name: {{ jenkins_service_name }}
  namespace: {{ jenkins_namespace }}
spec:
  type: {{ jenkins_service_type }}
  selector:
    app: {{ jenkins_app_name }}
  ports:
    - name: http
      port: {{ jenkins_http_port }}
      targetPort: {{ jenkins_http_port }}
    - name: agent
      port: {{ jenkins_agent_port }}
      targetPort: {{ jenkins_agent_port }}
