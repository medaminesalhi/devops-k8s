apiVersion: v1
kind: ServiceAccount
metadata:
  name: {{ ci_service_account_name }}
  namespace: {{ app_namespace }}
  labels:
    app: ci
    component: deployer
    managed-by: ansible
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: {{ ci_role_name }}
  namespace: {{ app_namespace }}
  labels:
    app: ci
    component: deployer
    managed-by: ansible
rules:
  - apiGroups: [""]
    resources:
      - pods
      - services
      - endpoints
      - events
    verbs:
      - get
      - list
      - watch

  - apiGroups: ["apps"]
    resources:
      - deployments
      - replicasets
    verbs:
      - get
      - list
      - watch

  - apiGroups: ["apps"]
    resources:
      - deployments
    verbs:
      - patch
      - update

  - apiGroups: [""]
    resources:
      - pods/log
    verbs:
      - get
      - list
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: {{ ci_rolebinding_name }}
  namespace: {{ app_namespace }}
  labels:
    app: ci
    component: deployer
    managed-by: ansible
subjects:
  - kind: ServiceAccount
    name: {{ ci_service_account_name }}
    namespace: {{ app_namespace }}
roleRef:
  kind: Role
  name: {{ ci_role_name }}
  apiGroup: rbac.authorization.k8s.io
