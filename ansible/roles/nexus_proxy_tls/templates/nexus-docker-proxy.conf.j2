server {
    listen {{ nexus_docker_tls_port }} ssl;
    server_name {{ nexus_proxy_server_name }};

    ssl_certificate {{ nexus_tls_dir }}/nexus.crt;
    ssl_certificate_key {{ nexus_tls_dir }}/nexus.key;

    client_max_body_size 0;
    chunked_transfer_encoding on;

    location / {
        proxy_pass http://127.0.0.1:{{ nexus_docker_backend_port }};
        proxy_set_header Host $host:$server_port;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Docker-Distribution-Api-Version registry/2.0;
        proxy_read_timeout 900;
    }
}
