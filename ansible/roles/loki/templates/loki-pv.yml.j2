apiVersion: v1
kind: PersistentVolume
metadata:
  name: {{ loki_pv_name }}
spec:
  capacity:
    storage: {{ loki_storage_size }}
  accessModes:
    - ReadWriteOnce
  storageClassName: {{ loki_storage_class }}
  persistentVolumeReclaimPolicy: Retain
  nfs:
    server: {{ loki_nfs_server }}
    path: {{ loki_nfs_path }}
